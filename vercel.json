{
  "routes": [
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "^/support/?$", "dest": "/support.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-notifications?slot=morning", "schedule": "30 6 * * *" },
    { "path": "/api/send-notifications?slot=evening", "schedule": "0 19 * * *" },
    { "path": "/api/family-size-reminders", "schedule": "0 16 * * 0" }
  ]
}
