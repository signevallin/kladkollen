{
  "routes": [
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "^/support/?$", "dest": "/support.html" },
    { "src": "^/privacy/?$", "dest": "/privacy.html" },
    { "src": "^/terms/?$", "dest": "/terms.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-notifications", "schedule": "30 6 * * *" },
    { "path": "/api/family-size-reminders", "schedule": "0 16 * * 0" }
  ]
}
