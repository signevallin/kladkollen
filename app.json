{
  "expo": {
    "name": "Klädkollen",
    "slug": "kladkollen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kladkollen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.kladkollen.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.kladkollen.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEFAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Klädkollen",
      "shortName": "Klädkollen",
      "description": "Din digitala garderob",
      "themeColor": "#FEFAF8",
      "backgroundColor": "#FEFAF8"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEFAF8",
          "dark": {
            "backgroundColor": "#181009"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Klädkollen behöver åtkomst till dina foton för att du ska kunna lägga till bilder på dina plagg.",
          "cameraPermission": "Klädkollen behöver åtkomst till kameran för att du ska kunna ta bilder på dina plagg."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Klädkollen använder din plats för att hämta det lokala vädret och föreslå outfits som passar dagens väder."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#402D21"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Klädkollen läser din kalender för att föreslå en outfit som passar dagens planer."
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2f95b5b1-c506-4d79-9aba-94d15424e860"
      }
    }
  }
}
